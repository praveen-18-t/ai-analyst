# Copy to .env  (docker compose reads it automatically)

# --- LLM: choose one -------------------------------------------------------------
LLM_PROVIDER=anthropic            # anthropic | bedrock
ANTHROPIC_API_KEY=                # required when LLM_PROVIDER=anthropic
LLM_MODEL=
# For Bedrock (AWS credentials come from the environment / IAM role). Verify the model or
# inference-profile id that is enabled in YOUR account and region.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_REGION=us-east-1

# --- Limits ----------------------------------------------------------------------
MAX_ROWS=10000
QUERY_TIMEOUT_S=30
MAX_UPLOAD_MB=200
MAX_QUESTIONS_PER_DAY=500

# --- Embeddings for document Q&A: hash (offline) | bedrock -----------------------
EMBEDDINGS_PROVIDER= 
